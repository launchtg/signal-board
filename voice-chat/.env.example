# ---- Claude API ----
# Get a key at https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-opus-4-8.
# For faster/cheaper voice replies, try claude-sonnet-4-6.
# CLAUDE_MODEL=claude-opus-4-8

# ---- Dropbox ----
# Create an app at https://www.dropbox.com/developers/apps (Scoped access,
# App folder or Full Dropbox). Give it the files.content.write permission.
# Then generate a refresh token (see README).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional: which folder transcripts land in. Defaults to "/Claude Chats".
# DROPBOX_FOLDER=/Claude Chats
